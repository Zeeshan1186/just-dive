RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ------------------------------------------------------------
# 💾 Browser Caching for Static Assets
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration
  ExpiresDefault "access plus 7 days"

  # Images – 1 year
  ExpiresByType image/webp "access plus 1 year"

  # Fonts – 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS & JS – 7 days
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"

  # Videos – 1 month
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

# ------------------------------------------------------------
# 🧩 Cache-Control Headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
  # Long-term cache for versioned assets (hashed files)
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|ico|ttf|woff|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Disable cache for HTML (ensures new deploys load fresh)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 🌐 Cross-Origin Resource Sharing (CORS) for preloaded assets
# ------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|woff|woff2|ttf|svg|png|jpg|jpeg|gif|mp4|webm)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 🔒 Security Headers (optional but recommended)
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>